{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HANA Knowledge Engine",
  "version": "0.1.0",
  "identifier": "com.hana.knowledge-engine",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HANA",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": ["binaries/hana-engine"],
    "copyright": "HANA Knowledge Engine",
    "category": "DeveloperTool",
    "shortDescription": "Motor de conocimiento técnico local",
    "longDescription": "Analiza proyectos Oracle, APEX, PL/SQL, MOCA y JasperReports de forma local, construye un grafo de conocimiento con procedencia verificable y funciona sin conexión a internet.",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
