{
  "name": "jarvis-knowledge-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Local technical knowledge engine for Oracle, APEX, PL/SQL, MOCA and JasperReports projects",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @jarvis/desktop dev",
    "build": "pnpm --filter @jarvis/desktop build",
    "tauri:dev": "pnpm --filter @jarvis/desktop tauri:dev",
    "tauri:build": "pnpm --filter @jarvis/desktop tauri:build",
    "build:sidecar": "python scripts/build_sidecar.py",
    "build:desktop": "python scripts/build_sidecar.py && pnpm --filter @jarvis/desktop tauri:build",
    "typecheck": "pnpm -r typecheck",
    "test:ui": "pnpm --filter @jarvis/desktop test",
    "test:engine": "python -m pytest engine/tests",
    "test:native": "cargo test --manifest-path crates/jarvis-fs/Cargo.toml",
    "test": "pnpm run test:engine && pnpm run test:native && pnpm run test:ui"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
